<% content_for :title, "成分検索" %>

<h1 class="text-2xl font-bold">成分検索</h1>
<p class="mt-2 text-sm leading-relaxed text-gray-700">
  製品の裏ラベルに書かれている成分名を1つ入力してください。ひらがな・カタカナ・INCI名(英語の成分名)で入力すると、登録されている成分名を候補に表示します。
</p>

<%= form_with url: root_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-2" do |f| %>
  <%= render "shared/ingredient_search_field", form: f, value: @query, required: true %>
  <%= f.submit "調べる", name: nil, class: "rounded bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
<% end %>

<% if @result %>
  <section aria-labelledby="result-heading" class="mt-8 space-y-4">
    <h2 id="result-heading" class="text-lg font-bold">「<%= @query %>」の検索結果</h2>
    <%= render "searches/result", result: @result %>
  </section>
<% end %>

<%# 成分詳細のモーダルを入れる枠(バッジの data-turbo-frame="modal" で中身が入る) %>
<%= turbo_frame_tag "modal" %>
