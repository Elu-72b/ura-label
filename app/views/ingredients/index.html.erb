<% content_for :title, "成分辞典" %>

<h1 class="text-2xl font-bold">成分辞典</h1>
<p class="mt-2 text-sm text-gray-700">登録されている成分を五十音順に並べています。成分名を選ぶと詳細を表示します。</p>

<div class="mt-4">
  <%= render "shared/caution_legend" %>
</div>

<p class="mt-6 text-sm"><%= @ingredients.size %>件</p>
<% if @ingredients.any? %>
  <ul class="mt-2 divide-y divide-gray-200">
    <% @ingredients.each do |ingredient| %>
      <li class="flex flex-wrap items-center gap-2 py-3">
        <%= render "ingredients/badge", ingredient: ingredient %>
        <%= render "shared/ai_tag" if ingredient.ai_generated? %>
        <span class="text-sm text-gray-700"><%= ingredient.category %></span>
      </li>
    <% end %>
  </ul>
  <div class="mt-4">
    <%= render "shared/caution_note" %>
  </div>
<% else %>
  <p class="mt-2">表示できる成分はありません。</p>
<% end %>
