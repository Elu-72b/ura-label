<%# 成分詳細の本文。成分詳細ページと、モーダル(ボトムシート)の両方で使う %>
<%# locals: (ingredient:) %>
<article class="space-y-4">
  <header>
    <h1 id="ingredient-name" class="text-xl font-bold"><%= ingredient.name %></h1>
    <% if ingredient.inci_name.present? %>
      <p class="text-sm text-gray-700"><%= ingredient.inci_name %></p>
    <% end %>
    <% if ingredient.ai_generated? %>
      <p class="mt-1"><%= render "shared/ai_tag" %></p>
    <% end %>
  </header>

  <dl class="space-y-3">
    <div>
      <dt class="text-sm font-semibold">注意度(刺激リスクの目安)</dt>
      <dd class="mt-1"><%= render "shared/caution_level", level: ingredient.caution_level %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold">配合目的の分類</dt>
      <dd class="mt-1"><%= ingredient.category %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold">主な配合目的</dt>
      <dd class="mt-1"><%= ingredient.purpose %></dd>
    </div>
    <% if ingredient.description.present? %>
      <div>
        <dt class="text-sm font-semibold">説明</dt>
        <dd class="mt-1 leading-relaxed"><%= ingredient.description %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-sm font-semibold">注意度の判定に使った出典</dt>
      <dd class="mt-1 space-y-1 text-sm">
        <% if ingredient.source.present? %>
          <p><%= ingredient.source %></p>
          <% source_url = source_link_url(ingredient.source_url) %>
          <% if source_url %>
            <p><%= link_to "出典のページを開く(別のタブ)", source_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %></p>
          <% end %>
          <% if ingredient.source_accessed_on %>
            <p>参照日: <%= ingredient.source_accessed_on.strftime("%Y-%m-%d") %></p>
          <% end %>
          <p class="text-gray-700">この出典は注意度の判定に使ったもので、配合目的の記載を裏付けるものではありません。</p>
        <% else %>
          <p>出典の記載はありません。</p>
        <% end %>
      </dd>
    </div>
  </dl>

  <% if ingredient.ai_generated? %>
    <p class="text-sm">この説明はAIにより生成されており、誤りを含む可能性があります。</p>
  <% end %>
  <%= render "shared/caution_note" %>
  <p class="text-sm"><%= link_to "注意度について", caution_path, class: "underline" %></p>
</article>
