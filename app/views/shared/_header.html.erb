<%# 全ページ共通のヘッダー。メニューの開閉は app/javascript/controllers/menu_controller.js %>
<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <%= link_to "うらラベル", root_path, class: "text-lg font-bold" %>

    <div class="relative" data-controller="menu"
         data-action="click@window->menu#closeOnOutsideClick keydown.esc@window->menu#close turbo:before-cache@document->menu#hide">
      <button type="button" aria-label="メニュー" aria-expanded="false" aria-controls="site-menu"
              data-menu-target="button" data-action="menu#toggle"
              class="rounded p-2 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
        <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <nav id="site-menu" aria-label="メニュー" hidden data-menu-target="menu"
           class="absolute right-0 z-30 mt-2 w-56 rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
        <ul>
          <li>
            <%= link_to "注意度について", caution_path, data: { action: "menu#close" },
                  class: "block px-4 py-3 hover:bg-gray-100 focus-visible:bg-gray-100" %>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
