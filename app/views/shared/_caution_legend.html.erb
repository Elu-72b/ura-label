<%# 注意度の凡例。成分の一覧・検索結果の上に置く %>
<div class="rounded-lg border border-gray-200 p-3">
  <p class="text-sm font-semibold">注意度(刺激リスクの目安)</p>
  <ul class="mt-2 flex flex-wrap gap-2">
    <% Ingredient::CAUTION_LEVELS.each do |level| %>
      <li><%= render "shared/caution_level", level: level %></li>
    <% end %>
  </ul>
  <p class="mt-2 text-xs"><%= link_to "注意度について", caution_path, class: "underline" %></p>
</div>
